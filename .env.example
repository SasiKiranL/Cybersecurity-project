# Base64-encoded 32-byte master key
CV_MASTER_KEY=replace-with-a-random-base64-32-byte-key

# Base64-encoded 32-byte shared secret for HMAC sensor API requests
CV_HMAC_SECRET=replace-with-a-random-base64-32-byte-secret

# Session signing and CSRF secret
CV_SESSION_SECRET=replace-with-a-long-random-secret

# Application storage
CV_DB_PATH=data/campusvault.db

# Server ports
CV_PORT_PORTAL=8443
CV_PORT_API=8444

# PKI certificates and private keys
CV_PKI_CA_CERT=pki/ca.crt
CV_PKI_CA_KEY=pki/private/ca.key
CV_PKI_SERVER_CERT=pki/server.crt
CV_PKI_SERVER_KEY=pki/private/server.key
CV_PKI_CLIENT_CERT=pki/client.crt
CV_PKI_CLIENT_KEY=pki/private/client.key

# Sensor API settings
CV_RATE_LIMIT=10/minute
CV_HMAC_TOLERANCE_SECONDS=300
