# ==========================================
# CampusVault — Git Ignore Rules
# ==========================================

# 1. Environment Secrets & Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.key
*.pem
pki/private/
pki/*.key
keys_backup.json
*.pfx
*.p12

# 2. Database & Persistent Runtime Storage
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 3. Python Virtual Environments
.venv/
venv/
ENV/
env/

# 4. Python Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 5. Testing, Linting & Coverage Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.log

# 7. IDE Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace